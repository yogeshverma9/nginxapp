--- /dev/null
+++ b/templates/ingress.yaml
@@ -0,0 +1,26 @@
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  annotations:
+    haproxy.org/ssl-redirect: "false"
+  labels:
+    app: {{ .Values.service.label }}
+  name: app-ingress
+  namespace: {{ .Values.deployment.namespace }}
+spec:
+  ingressClassName: haproxy
+  tls:
+    - hosts:
+        - {{ .Values.route.host }}
+      secretName: {{ .Values.route.tlsSecretName }}
+  rules:
+    - host: {{ .Values.route.host }}
+      http:
+        paths:
+          - path: {{
+            pathType: Prefix
+            backend:
+              service:
+                name: app-service
+                port:
+                  number: {{ .Values.service.portValue }}
--- a/templates/route.yaml
+++ /dev/null
@@ -1,28 +0,0 @@
-{{- if .Values.route.enabled }}
-apiVersion: route.openshift.io/v1
-kind: Route
-metadata:
-  name: {{ include "nginx-ocp.fullname" . }}
-  namespace: {{ .Values.namespace }}
-  labels:
-    {{- include "nginx-ocp.labels" . | nindent 4 }}
-spec:
-  {{- with .Values.route.host }}
-  host: {{ . | quote }}
-  {{- end }}
-  {{- with .Values.route.path }}
-  path: {{ . | quote }}
-  {{- end }}
-  to:
-    kind: Service
-    name: {{ include "nginx-ocp.fullname" . }}
-    weight: 100
-  port:
-    targetPort: http
-  wildcardPolicy: {{ .Values.route.wildcardPolicy }}
-  {{- if .Values.route.tls.enabled }}
-  tls:
-    termination: {{ .Values.route.tls.termination }}
-    insecureEdgeTerminationPolicy: {{ .Values.route.tls.insecureEdgeTerminationPolicy }}
-  {{- end }}
-{{- end }}
